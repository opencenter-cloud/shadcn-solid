{
  "name": "unocss-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "start": "vite start",
    "format": "prettier --write ./src",
    "lint": "eslint --fix ./src",
    "ci:lint": "eslint --report-unused-disable-directives ./src",
    "ci:format": "prettier --check ./src"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@unocss/preset-wind4": "^66.5.5",
    "unocss": "^66.5.5",
    "vite": "^7.1.7",
    "vite-plugin-solid": "3.0.0-next.5",
    "vite-tsconfig-paths": "^5.1.4",
    "@solidjs/web": "2.0.0-beta.15",
    "babel-preset-solid": "2.0.0-beta.15"
  },
  "dependencies": {
    "@opencenter-cloud/kobalte-core": "^0.1.6",
    "@opencenter-cloud/cmdk-solid": "workspace:*",
    "@opencenter-cloud/somoto": "workspace:*",
    "@opencenter-cloud/unovis-solid": "workspace:*",
    "@corvu-next/drawer": "^0.1.3",
    "@corvu-next/resizable": "^0.1.3",
    "@solid-primitives/media": "4.0.0-next.0",
    "@tanstack/solid-router": "2.0.0-beta.21",
