{
  "name": "@opencenter-cloud/somoto",
  "version": "0.1.0",
  "description": "Solid 2 port of somoto — toast notifications for SolidJS",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.cjs",
  "module": "./dist/server.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "worker": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "browser": {
      "development": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/dev.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/dev.cjs"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "deno": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "node": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "development": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/dev.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/dev.cjs"
      }
    },
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src",
    "dev": "tsup src --watch"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-beta.14",
    "@solidjs/web": "^2.0.0-beta.14"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsup-preset-solid": "^2.2.0",
    "babel-preset-solid": "2.0.0-beta.15",
    "typescript": "^6.0.1",
    "solid-js": "2.0.0-beta.15",
    "@solidjs/web": "2.0.0-beta.15"
  },
  "sideEffects": true,
  "browser": {
    "./dist/server.js": "./dist/index.js",
    "./dist/server.cjs": "./dist/index.cjs"
  },
  "typesVersions": {}
}
